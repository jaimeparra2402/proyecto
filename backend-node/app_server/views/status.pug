doctype html
html(lang="es")
  head
    title Panel de Estado del Sistema
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
  body.bg-light
    div.container.mt-5
      div.card.shadow
        div.card-header.bg-primary.text-white
          h1.h3.m-0 Panel de Estado del Sistema (CI/CD OK)
        div.card-body
          p.lead Estado actual de las conexiones del backend de Node.js.
          hr
          div.row
            div.col-md-6
              div.p-3.mb-2.bg-success.text-white.rounded Base de Datos: Conectada (MongoDB Atlas)
            div.col-md-6
              div.p-3.mb-2.bg-info.text-dark.rounded API Externa: Operativa